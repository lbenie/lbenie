{
  "name": "lbenie-portfolio",
  "version": "2.0.0",
  "description": "Bilingual personal portfolio - Lucien Bénié",
  "type": "module",
  "private": true,
  "author": "Lucien Bénié",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=18.14.1",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/generate-og-image.mjs && astro check && astro build && node scripts/generate-cv.mjs",
    "generate:cv": "node scripts/generate-cv.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check --watch",
    "check:once": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@microsoft/clarity": "1.0.2",
    "@shikijs/transformers": "4.4.3",
    "astro": "7.2.10",
    "fuse.js": "7.5.0",
    "open-props": "1.7.23"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@lbenie/linting": "2.1.20",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "puppeteer": "25.10.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ]
  }
}
