---
import { getExperience } from '@utils/content';
import type { Locale } from '@/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = {
  en: {
    sectionTitle: 'Professional Summary',
    introduction: (years: number) =>
      `Staff Frontend Software Developer and AI leader with ${years}+ years building scalable applications and enterprise platforms.`,
  },
  fr: {
    sectionTitle: 'Résumé professionnel',
    introduction: (years: number) =>
      `Développeur frontend Staff et leader IA avec ${years}+ ans d'expérience dans la création d'applications évolutives et de plateformes d'entreprise.`,
  },
} as const;

const experiences = await getExperience(locale);
const earliestStartYear = Math.min(...experiences.map((experience) => experience.data.from.getFullYear()));
const yearsOfExperience = new Date().getFullYear() - earliestStartYear;
const currentExperience = experiences.find((experience) => experience.data.current);
const currentFocus = currentExperience?.data.resumeSummary ?? currentExperience?.data.description;
const copy = labels[locale];
---

<section class="section">
  <h2 class="section-title">{copy.sectionTitle}</h2>
  <p class="summary">
    {copy.introduction(yearsOfExperience)} {currentFocus}
  </p>
</section>

<style>
  .section {
    margin-bottom: 7px;
    page-break-inside: avoid;
  }

  .section-title {
    font-size: 12pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 3px;
    padding-bottom: 1px;
    border-bottom: 1.5px solid #1a1a1a;
  }

  .summary {
    font-size: 8.5pt;
    line-height: 1.22;
    text-align: justify;
  }

  @media print {
    .section {
      page-break-inside: avoid;
      break-inside: avoid;
    }
  }
</style>
