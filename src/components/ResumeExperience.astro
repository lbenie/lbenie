---
import { formatDateShort, formatDuration, getExperience } from '@utils/content';
import type { Locale } from '@/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = {
  en: {
    sectionTitle: 'Professional Experience',
    present: 'Present',
    remote: 'Remote',
  },
  fr: {
    sectionTitle: 'Expérience professionnelle',
    present: 'Présent',
    remote: 'Télétravail',
  },
} as const;

// Keep the print resume concise. Content and ordering come directly from the
// localized experience collection, so updates flow to both resume pages.
const EXPERIENCE_LIMIT = 3;
const HIGHLIGHT_LIMIT = 3;
const TECHNOLOGY_LIMIT = 6;

const copy = labels[locale];
const experiences = (await getExperience(locale)).slice(0, EXPERIENCE_LIMIT);
---

<section class="section">
  <h2 class="section-title">{copy.sectionTitle}</h2>
  {experiences.map((exp) => (
    <div class="experience-item">
      <div class="experience-header">
        <div class="experience-role">{exp.data.role}</div>
        <div class="experience-date">
          {formatDateShort(exp.data.from, locale)} – {exp.data.to ? formatDateShort(exp.data.to, locale) : copy.present}
          {' '}({formatDuration(exp.data.from, exp.data.to, locale)})
        </div>
      </div>
      <div class="experience-company">
        {exp.data.company} {exp.data.remote ? `(${copy.remote})` : ''}
      </div>
      {exp.data.location && (
        <div class="experience-location">{exp.data.location}</div>
      )}
      {exp.data.highlights.length > 0 && (
        <div class="experience-highlights">
          <ul>
            {exp.data.highlights.slice(0, HIGHLIGHT_LIMIT).map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        </div>
      )}
      {exp.data.stack.length > 0 && (
        <div class="experience-stack">
          {exp.data.stack.slice(0, TECHNOLOGY_LIMIT).map((tech) => (
            <span class="tech-tag">{tech}</span>
          ))}
        </div>
      )}
    </div>
  ))}
</section>

<style>
  .section {
    margin-bottom: 10px;
    page-break-inside: avoid;
  }

  .section-title {
    font-size: 12pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 5px;
    padding-bottom: 2px;
    border-bottom: 1.5px solid #1a1a1a;
  }

  .experience-item {
    margin-bottom: 8px;
    page-break-inside: avoid;
  }

  .experience-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2px;
  }

  .experience-role {
    font-size: 10pt;
    font-weight: 700;
    color: #1a1a1a;
  }

  .experience-date {
    font-size: 8pt;
    color: #4a4a4a;
    white-space: nowrap;
  }

  .experience-company {
    font-size: 9pt;
    font-weight: 600;
    color: #2563eb;
    margin-bottom: 1px;
  }

  .experience-location {
    font-size: 8pt;
    color: #6a6a6a;
    margin-bottom: 3px;
  }

  .experience-highlights {
    margin-top: 3px;
  }

  .experience-highlights ul {
    margin-left: 16px;
    list-style-type: disc;
  }

  .experience-highlights li {
    font-size: 8.5pt;
    line-height: 1.3;
    margin-bottom: 2px;
    text-align: justify;
  }

  .experience-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 4px;
  }

  .tech-tag {
    display: inline-block;
    padding: 1px 6px;
    background: #f3f4f6;
    border: 1px solid #d1d5db;
    border-radius: 3px;
    font-size: 7.5pt;
    font-weight: 500;
    color: #4a4a4a;
  }

  @media print {
    .section,
    .experience-item {
      page-break-inside: avoid;
      break-inside: avoid;
    }
  }
</style>
