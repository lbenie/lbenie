---
// Microsoft Clarity Analytics Component
//
// This component loads the Microsoft Clarity analytics script on your site.
// Clarity provides session recordings, heatmaps, and user insights.
//
// Configuration:
// - Set PUBLIC_CLARITY_PROJECT_ID in your .env file
// - Get your Project ID from: https://clarity.microsoft.com > Settings > Overview
//
// The script will only initialize if a valid Project ID is configured.
// See src/scripts/clarity.ts for the initialization logic.
---

<script>
  const loadTracking = () => import('../../scripts/track-interactions');
  const requestIdle = Reflect.get(window, 'requestIdleCallback') as typeof window.requestIdleCallback | undefined;

  if (requestIdle) {
    requestIdle(loadTracking, { timeout: 3000 });
  } else {
    window.setTimeout(loadTracking, 2000);
  }
</script>
